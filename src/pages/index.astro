---
const services=[
 {icon:"♥",title:"Personal Care",text:"Respectful support with everyday personal care."},
 {icon:"☕",title:"Companionship",text:"Friendly visits and meaningful time together."},
 {icon:"⌂",title:"Help Around the Home",text:"Support with daily tasks, meals and a clean, safe home."},
 {icon:"☀",title:"Getting Out and About",text:"Support to attend appointments, social events and community activities."}
];
const wellbeing=["Meaningful activities","New friendships","Days out & experiences","Staying active & connected"];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#14533f"/><title>KC Care & Wellbeing | Care at Home & Wellbeing Days</title><meta name="description" content="KC Care & Wellbeing provides friendly care at home, companionship and welcoming wellbeing days for older people."/><link rel="canonical" href="https://kc-care.org/"/>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Patrick+Hand&display=swap');
:root{--ink:#153f38;--green:#14533f;--green2:#26765b;--cream:#fffaf1;--sage:#eaf4e9;--pink:#fde7e4;--yellow:#fff0ba;--white:#fff;--text:#384740;--muted:#68756e}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--text);font-family:"DM Sans",sans-serif;line-height:1.55;overflow-x:hidden}.wrap{width:min(1180px,calc(100% - 42px));margin:auto}a{color:inherit}.nav{height:84px;display:flex;align-items:center;justify-content:space-between}.logo{font:400 31px "Patrick Hand",cursive;text-decoration:none;color:var(--ink);line-height:.8}.logo small{font:500 10px "DM Sans",sans-serif;display:block;letter-spacing:.04em;margin-top:8px}.links{display:flex;align-items:center;gap:26px}.links a{text-decoration:none;font-size:13px;font-weight:600}.button{display:inline-flex;align-items:center;gap:10px;background:var(--green);color:#fff!important;text-decoration:none;border-radius:100px;padding:13px 22px;font-weight:700;box-shadow:0 7px 20px rgba(20,83,63,.12);transition:.25s}.button:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(20,83,63,.18)}.outline{background:#fff;color:var(--green)!important;border:1px solid #b8c9bf;box-shadow:none}.hero{padding:38px 0 76px;position:relative}.heroGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:35px;align-items:center}h1,h2,h3{font-family:"Patrick Hand",cursive;color:var(--ink);font-weight:400}h1{font-size:clamp(55px,6.3vw,88px);line-height:.9;margin:12px 0 23px;max-width:650px}.lead{font-size:18px;max-width:570px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.trust{display:flex;gap:23px;flex-wrap:wrap;margin-top:35px;font-size:12px}.trust span{display:flex;align-items:center;gap:8px}.trust b{font-size:21px;color:#ed6b7d}.scene{height:520px;position:relative;border-radius:45% 45% 35px 35px;overflow:hidden;background:#f6eadc}.scene img{width:100%;height:100%;object-fit:cover;animation:floatImage 7s ease-in-out infinite}.badge{position:absolute;left:8%;bottom:22px;background:rgba(255,255,255,.92);padding:14px 20px;border-radius:18px;font:25px "Patrick Hand";color:var(--green);box-shadow:0 10px 35px #124c3820}@keyframes floatImage{50%{transform:scale(1.025) translateY(-3px)}}@keyframes float{50%{transform:translateY(-9px) rotate(1deg)}}@keyframes pulse{50%{transform:scale(1.15) rotate(5deg)}}@keyframes twinkle{50%{opacity:.3;transform:rotate(12deg)}}.wave{height:60px;background:var(--sage);clip-path:ellipse(65% 55% at 50% 100%)}section{padding:80px 0}.care{background:var(--sage)}.sectionGrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:65px;align-items:center}.illustration{height:410px;border-radius:42% 42% 24px 24px;position:relative;overflow:hidden}.illustration img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.illustration:hover img{transform:scale(1.04)}.sectionTitle h2{font-size:55px;line-height:.95;margin:7px 0 15px}.sectionTitle p{font-size:17px;max-width:620px}.services{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:35px}.service{background:rgba(255,255,255,.9);border-radius:20px;padding:22px;transition:.25s}.service:hover{transform:translateY(-5px)}.service .icon{font-size:25px;color:#e95f79}.service h3{font-size:27px;margin:8px 0 5px}.service p{font-size:13px;color:var(--muted)}.wellbeing{background:var(--pink);position:relative}.wellGrid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.activity{height:420px;border-radius:28px;position:relative;overflow:hidden}.activity img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.activity:hover img{transform:scale(1.04)}.wellList{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.wellItem{background:#fff9;padding:13px 16px;border-radius:15px;font-size:13px}.values{background:#fff;padding:24px 0}.valueRow{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;text-align:center}.value{font-size:13px}.value b{display:block;font-size:27px;margin-bottom:5px}.more{background:#dff0f4;position:relative}.moreCard{min-height:320px;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:50px}.landscape{height:250px;border-radius:50% 50% 20px 20px;position:relative;overflow:hidden}.landscape img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.landscape:hover img{transform:scale(1.035)}@keyframes drive{50%{transform:translateX(35px)}}.contact{background:#fffaf1}.contactBox{background:var(--green);color:white;border-radius:28px;padding:45px;display:flex;justify-content:space-between;align-items:center;gap:30px}.contactBox h2{color:white;font-size:45px;margin:0}.contactBox p{margin:5px 0 0;color:#dcebe5}.contactBox .button{background:white;color:var(--green)!important}footer{padding:30px 0;font-size:12px;color:var(--muted)}.foot{display:flex;justify-content:space-between}@media(max-width:800px){.links a:not(.button){display:none}.heroGrid,.sectionGrid,.wellGrid,.moreCard{grid-template-columns:1fr}.hero{padding-top:20px}.scene{height:390px}.services{grid-template-columns:1fr}.valueRow{grid-template-columns:1fr 1fr}.sectionTitle h2{font-size:45px}.contactBox{display:block}.contactBox .button{margin-top:20px}.foot{flex-direction:column;gap:7px}.wrap{width:min(100% - 30px,1180px)}}
</style></head><body>
<header><div class="wrap nav"><a class="logo" href="/">♥ KC Care<small>People at the heart of care</small></a><nav class="links"><a href="#homecare">Home Care</a><a href="#wellbeing">Wellbeing Days</a><a href="#about">About Us</a><a href="#contact">Contact</a><a class="button" href="#contact">Get in touch →</a></nav></div></header>
<main><section class="hero"><div class="wrap heroGrid"><div><h1>Support today for brighter tomorrows</h1><p class="lead">Personal, friendly care at home and welcoming wellbeing days that help people live happier, more independent lives.</p><div class="actions"><a class="button" href="#homecare">Our Care Services →</a><a class="button outline" href="#wellbeing">Wellbeing Days</a></div><div class="trust"><span><b>♥</b> Kind and family focused</span><span><b>☀</b> Supporting independence</span><span><b>⌂</b> Part of the community</span></div></div><div class="scene"><img src="data:image/webp;base64," alt="KC Care representative sharing a happy moment with an older care user"/><div class="badge">Care with a smile ♥</div></div></div></section>
<section id="homecare" class="care"><div class="wrap"><div class="sectionGrid"><div class="illustration"><img src="data:image/webp;base64," alt="KC Care representative spending time with an older gentleman"/></div><div><div class="sectionTitle"><h2>Home Care</h2><p>Tailored, one-to-one support in the comfort of home, helping with everyday life, companionship and maintaining independence.</p></div><div class="services">{services.map(s=><article class="service"><div class="icon">{s.icon}</div><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></div></div></section>
<section id="wellbeing" class="wellbeing"><div class="wrap wellGrid"><div><div class="sectionTitle"><h2>Wellbeing Days</h2><p>Friendly, supportive days filled with activities, social time and fun experiences — helping people stay active, connected and confident.</p></div><div class="wellList">{wellbeing.map(x=><div class="wellItem">♥ {x}</div>)}</div></div><div class="activity"><img src="data:image/webp;base64," alt="KC Care wellbeing day with painting, conversation and company"/></div></div></section>
<div class="values"><div class="wrap valueRow"><div class="value"><b>🌱</b>Meaningful activities</div><div class="value"><b>☕</b>New friendships</div><div class="value"><b>☀️</b>Days out & experiences</div><div class="value"><b>♥</b>Boosting wellbeing</div></div></div>
<section id="about" class="more"><div class="wrap moreCard"><div class="landscape"><img src="data:image/webp;base64," alt="KC Care community transport on a wellbeing day"/></div><div class="sectionTitle"><h2>More than care</h2><p>We're here to support people to live well, stay connected and be part of their community — with kindness, friendship and independence at the heart of everything.</p><a class="button" href="#contact">About KC Care →</a></div></div></section>
<section id="contact" class="contact"><div class="wrap"><div class="contactBox"><div><h2>Let's have a chat.</h2><p>Looking for care at home, companionship or a wellbeing day? Talk to KC Care.</p></div><a class="button" href="#">Contact details coming soon</a></div></div></section></main>
<footer><div class="wrap foot"><span>© 2026 KC Care & Wellbeing</span><span>Care • Companionship • Wellbeing</span></div></footer></body></html>